# Run scripts/setup.ps1 to generate local demo keys. Never commit .env.
APP_MODE=demo
DB_PATH=data/local/people-quality.db
API_URL=http://127.0.0.1:8000
ANALYST_KEY=replace-with-random-value-at-least-24-characters
REVIEWER_KEY=replace-with-a-different-random-value
OPERATOR_KEY=replace-with-a-third-random-value
